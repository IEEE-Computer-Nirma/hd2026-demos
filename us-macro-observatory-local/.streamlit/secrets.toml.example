# Snowflake secrets for st.connection("snowflake") (Snowpark-backed).
# Copy this file to secrets.toml and fill in your credentials.
# NEVER commit secrets.toml to version control!

[connections.snowflake]
account = "your_account"          # e.g. "xy12345.us-east-1" or "myorg-myaccount"
user = "your_username"
password = "your_password"
role = "ACCOUNTADMIN"             # or any role with access to the public data
warehouse = "COMPUTE_WH"
database = "SNOWFLAKE_PUBLIC_DATA_FREE"
schema = "PUBLIC_DATA_FREE"
